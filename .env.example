# 复制为 .env 并填入你的密钥（.env 已被 .gitignore 忽略，不会上传）
# 切换提供方 = 改 LLM_PROVIDER 一行（可选值见 llmkit/config.py 的 PROVIDERS）
# 新增提供方 = llmkit/config.py 的 PROVIDERS 加一条 + 这里放它的密钥
# 换模型     = 取消注释对应的 <提供方>_MODEL 行（不填用注册表默认值）

LLM_PROVIDER=zenmux

# ---- zenmux（首选；直连不通，走本机代理）----
ZENMUX_API_KEY=sk-ss-v1-你的密钥
# ZENMUX_MODEL=z-ai/glm-5.3-flashx
# ZENMUX_PROXY=http://127.0.0.1:7897

# ---- nvidia（备用；国内直连，但推理接口经常超时，实测）----
NVIDIA_API_KEY=nvapi-你的密钥
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
